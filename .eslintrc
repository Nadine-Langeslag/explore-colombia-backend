{
  "extends": "airbnb-base",
  "env": {
    "node": true,
    "es2022": true,
  },
  "rules": {
    "no-console": "off",
    "no-underscore-dangle": ["error", { "allow": ["_id"] }],
    "linebreak-style": ["error", "unix"],
    "no-unused-vars": ["error", { "argsIgnorePattern": "next" }],
    "quotes": ["error", "double"],
    "import/extensions": [
      "error",
      "ignorePackages",
      {
        "js": "always",
      },
    ],
  },
}
